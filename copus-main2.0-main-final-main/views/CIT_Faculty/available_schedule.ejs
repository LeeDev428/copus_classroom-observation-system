<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Available Observation Schedules</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color-start: #0f2027;
            --primary-color-end: #203a43;
            --secondary-color-start: #2c5364;
            --secondary-color-end: #203a43;
            --text-light: #e0e0e0;
            --text-dark: #333;
            --sidebar-width: 280px;
            --accent-color: #17e891;
            --hover-color: rgba(255, 255, 255, 0.1);
            --border-color: rgba(255, 255, 255, 0.1);
            --card-bg: rgba(255, 255, 255, 0.05);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, var(--primary-color-start), var(--primary-color-end));
            color: var(--text-light);
            min-height: 100vh;
        }

        /* Header styles */
        header {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            font-weight: 600;
            font-size: 1.5rem;
            color: #fff;
        }

        .logo img {
            height: 40px;
            margin-right: 15px;
        }

        .header-title {
            font-size: 1.25rem;
            color: var(--text-light);
            margin-left: -150px;
        }

        /* Sidebar styles */
        .custom-sidebar {
            width: var(--sidebar-width);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            background: linear-gradient(to bottom, #11405b, #0f2027);
            color: var(--text-light);
            padding: 2rem 1.5rem;
            overflow-y: auto;
            z-index: 1001;
        }

        .custom-sidebar .nav-link {
            color: var(--text-light);
            padding: 0.75rem 1rem;
            margin: 0.25rem 0;
            border-radius: 8px;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .custom-sidebar .nav-link:hover {
            background: var(--hover-color);
            color: var(--accent-color);
        }

        .custom-sidebar .nav-link.active {
            background: var(--accent-color);
            color: var(--text-dark);
        }

        .custom-sidebar .nav-link i {
            margin-right: 0.75rem;
            width: 20px;
            text-align: center;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding-top: 2rem;
        }

        /* Main content */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 80px;
            padding: 2rem;
            min-height: calc(100vh - 80px);
        }

        .custom-card {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            border-radius: 15px;
            padding: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 600;
            color: var(--accent-color);
            margin-bottom: 2rem;
        }

        .custom-table {
            background: transparent;
        }

        .custom-table th {
            background: rgba(255, 255, 255, 0.1);
            color: var(--accent-color);
            border-color: var(--border-color);
            font-weight: 600;
        }

        .custom-table td {
            border-color: var(--border-color);
            color: var(--text-light);
        }

        .custom-table tbody tr:hover {
            background: var(--hover-color);
        }

        .btn-select {
            background: var(--accent-color);
            border: none;
            color: var(--text-dark);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            transition: all 0.3s;
        }

        .btn-select:hover {
            background: #0fd67a;
            transform: translateY(-2px);
        }

        .modal-content {
            background: linear-gradient(135deg, var(--primary-color-start), var(--primary-color-end));
            border: 1px solid var(--border-color);
            color: var(--text-light);
        }

        .modal-header {
            border-bottom: 1px solid var(--border-color);
        }

        .modal-footer {
            border-top: 1px solid var(--border-color);
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid var(--border-color);
            color: var(--text-light);
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.25rem rgba(23, 232, 145, 0.25);
            color: var(--text-light);
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .form-control option {
            background: var(--primary-color-end);
            color: var(--text-light);
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.2);
            border: 1px solid rgba(40, 167, 69, 0.4);
            color: #d4edda;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.4);
            color: #f8d7da;
        }

        .text-muted {
            color: rgba(224, 224, 224, 0.6) !important;
        }

        .search-container .form-control {
            border-radius: 25px;
            padding: 0.75rem 1.5rem;
        }

        @media (max-width: 768px) {
            .custom-sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s;
            }

            .custom-sidebar.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            header {
                left: 0;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <header>
            <div class="logo">
                <img src="/images/logo_college.jpg" alt="Logo">
                <div class="header-title">COPUS Evaluation System</div>
            </div>
            <div class="header-icons">
                <i class="bi bi-bell" data-bs-toggle="tooltip" title="Notifications"></i>
                <div class="user-icon-circle">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>
        </header>

        <!-- Sidebar -->
        <nav class="custom-sidebar">
            <div class="mb-3">
                <h6 class="text-white mb-0">Welcome! <%= firstName %></h6>
                <small class="text-muted"><%= employeeId %></small>
            </div>
            <hr class="text-secondary">
            <a href="/CIT_Faculty_dashboard" class="nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/CIT_Faculty_copus_result" class="nav-link"><i class="bi bi-clipboard-data"></i> Copus Result</a>
            <a href="/CIT_Faculty_copus_history" class="nav-link"><i class="bi bi-clock-history"></i> Copus History</a>
            <a href="/CIT_Faculty_schedule_management" class="nav-link"><i class="bi bi-calendar-event-fill"></i> My Schedules</a>
            <a href="/CIT_Faculty_available_schedule" class="nav-link active"><i class="bi bi-calendar-plus"></i> Available Observation Slots</a>
            <a href="/CIT_Faculty_setting" class="nav-link"><i class="bi bi-gear-fill"></i> Account & Profile Settings</a>
            <div class="sidebar-bottom">
                <form action="/logout" method="POST">
                    <button type="submit" class="btn btn-outline-danger w-100">Logout <i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <div class="custom-card">
                <!-- Flash Messages -->
                <% if (success_msg && success_msg.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <span><%= success_msg %></span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (error_msg && error_msg.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <span><%= error_msg %></span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <h2 class="page-title">Available Observation Slots</h2>
                
                <!-- Search -->
                <div class="search-container mb-4">
                    <input type="text" id="tableSearch" class="form-control" placeholder="Search by date, time, subject, or observer...">
                </div>

                <!-- Available Schedules Table -->
                <div class="table-responsive">
                    <table id="availableScheduleTable" class="table custom-table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Subject Details</th>
                                <th>Room</th>
                                <th>Observers</th>
                                <th>COPUS Type</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (availableSchedules && availableSchedules.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted">No available observation slots found.</td>
                                </tr>
                            <% } else if (availableSchedules) { %>
                                <% availableSchedules.forEach(schedule => { %>
                                    <tr>
                                        <td class="text-nowrap">
                                            <%= new Date(schedule.date).toLocaleDateString('en-US', { 
                                                weekday: 'short', 
                                                month: 'short', 
                                                day: 'numeric', 
                                                year: 'numeric' 
                                            }) %>
                                        </td>
                                        <td class="text-nowrap"><%= schedule.start_time %> - <%= schedule.end_time %></td>
                                        <td>
                                            <div><strong><%= schedule.subject_code %></strong></div>
                                            <small class="text-muted"><%= schedule.subject_name %></small>
                                            <br>
                                            <small class="text-muted">
                                                <%= schedule.year_level %> - <%= schedule.semester %><br>
                                                <%= schedule.modality %>
                                            </small>
                                        </td>
                                        <td><%= schedule.room %></td>
                                        <td>
                                            <% if (schedule.observers && schedule.observers.length > 0) { %>
                                                <% schedule.observers.forEach(obs => { %>
                                                    <small class="d-block"><%= obs.observer_name %></small>
                                                <% }); %>
                                            <% } else { %>
                                                <span class="text-muted">No observers assigned</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-info"><%= schedule.copus_type %></span>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-select btn-sm"
                                                data-bs-toggle="modal" data-bs-target="#selectScheduleModal"
                                                data-schedule-id="<%= schedule._id %>"
                                                data-date="<%= new Date(schedule.date).toLocaleDateString() %>"
                                                data-start-time="<%= schedule.start_time %>"
                                                data-end-time="<%= schedule.end_time %>"
                                                data-subject-code="<%= schedule.subject_code %>"
                                                data-subject-name="<%= schedule.subject_name %>"
                                                data-room="<%= schedule.room %>"
                                                data-copus-type="<%= schedule.copus_type %>"
                                                data-observers='<%= schedule.observers ? JSON.stringify(schedule.observers.map(o => o.observer_name)) : "[]" %>'
                                                Select Slot
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Select Schedule Modal -->
    <div class="modal fade" id="selectScheduleModal" tabindex="-1" aria-labelledby="selectScheduleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="selectScheduleForm" action="/faculty/select_schedule_slot" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title" id="selectScheduleModalLabel">Confirm Observation Schedule Selection</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="modalScheduleId" name="scheduleId">
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-primary border-bottom border-primary pb-2">Schedule Details</h6>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Date:</label>
                                    <p class="form-control-plaintext text-white" id="modalDate"></p>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Time:</label>
                                    <p class="form-control-plaintext text-white" id="modalTime"></p>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Subject:</label>
                                    <p class="form-control-plaintext text-white" id="modalSubject"></p>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Room:</label>
                                    <p class="form-control-plaintext text-white" id="modalRoom"></p>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label mb-0">COPUS Type:</label>
                                    <p class="form-control-plaintext text-white" id="modalCopusType"></p>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-primary border-bottom border-primary pb-2">Faculty Information</h6>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Faculty:</label>
                                    <p class="form-control-plaintext text-white"><%= firstName %> <%= lastName %></p>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Department:</label>
                                    <p class="form-control-plaintext text-white"><%= department %></p>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label mb-0">Employee ID:</label>
                                    <p class="form-control-plaintext text-white"><%= employeeId %></p>
                                </div>
                            </div>
                        </div>

                        <h6 class="text-primary border-bottom border-primary pb-2 mt-4">Observers</h6>
                        <div id="modalObservers" class="mb-3"></div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Note:</strong> By selecting this slot, you confirm that you will be available at the specified date and time for the observation session.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Confirm Selection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modal population function using event delegation
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-select')) {
                const button = e.target;
                const id = button.getAttribute('data-schedule-id');
                const date = button.getAttribute('data-date');
                const startTime = button.getAttribute('data-start-time');
                const endTime = button.getAttribute('data-end-time');
                const subjectCode = button.getAttribute('data-subject-code');
                const subjectName = button.getAttribute('data-subject-name');
                const room = button.getAttribute('data-room');
                const copusType = button.getAttribute('data-copus-type');
                const observersJSON = button.getAttribute('data-observers');

                document.getElementById('modalScheduleId').value = id;
                document.getElementById('modalDate').textContent = date;
                document.getElementById('modalTime').textContent = `${startTime} - ${endTime}`;
                document.getElementById('modalSubject').textContent = `${subjectCode} - ${subjectName}`;
                document.getElementById('modalRoom').textContent = room;
                document.getElementById('modalCopusType').textContent = copusType;

                // Parse and display observers
                try {
                    const observers = JSON.parse(observersJSON);
                    const observersContainer = document.getElementById('modalObservers');
                    if (observers.length > 0) {
                        observersContainer.innerHTML = observers.map(observer => 
                            `<span class="badge bg-secondary me-2 mb-2">${observer}</span>`
                        ).join('');
                    } else {
                        observersContainer.innerHTML = '<span class="text-muted">No observers assigned</span>';
                    }
                } catch (e) {
                    document.getElementById('modalObservers').innerHTML = '<span class="text-muted">Observer information unavailable</span>';
                }
            }
        });

        // Search functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('tableSearch');
            const tableBody = document.querySelector('#availableScheduleTable tbody');
            const originalRows = Array.from(tableBody.querySelectorAll('tr'));

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();
                
                originalRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Check if any rows are visible
                const visibleRows = originalRows.filter(row => row.style.display !== 'none');
                if (visibleRows.length === 0) {
                    // Show no results message
                    const noResultsRow = document.createElement('tr');
                    noResultsRow.innerHTML = '<td colspan="7" class="text-center text-muted">No matching observation slots found.</td>';
                    noResultsRow.id = 'noResultsRow';
                    tableBody.appendChild(noResultsRow);
                } else {
                    // Remove no results message if it exists
                    const noResultsRow = document.getElementById('noResultsRow');
                    if (noResultsRow) {
                        noResultsRow.remove();
                    }
                }
            });

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // Form submission handling
        document.getElementById('selectScheduleForm').addEventListener('submit', function(e) {
            const submitButton = this.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
        });
    </script>
</body>
</html>
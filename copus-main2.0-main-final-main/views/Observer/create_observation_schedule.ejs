<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Observation Schedule - ALC Observer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-color-start: #2c5aa0;
            --primary-color-end: #1a365d;
            --accent-color: #ffd700;
            --text-light: #ffffff;
            --text-dark: #333;
            --sidebar-width: 280px;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, var(--primary-color-start), var(--primary-color-end));
            color: var(--text-light);
            min-height: 100vh;
        }

        /* Sidebar styles */
        .custom-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            padding: 2rem 1.5rem;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .custom-sidebar h6 {
            color: var(--accent-color);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .custom-sidebar small {
            color: rgba(255, 255, 255, 0.7);
        }

        .custom-sidebar hr {
            border-color: rgba(255, 255, 255, 0.2);
        }

        .custom-sidebar a {
            color: var(--text-light);
            text-decoration: none;
            display: block;
            padding: 0.75rem 1rem;
            margin: 0.25rem 0;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .custom-sidebar a i {
            margin-right: 0.75rem;
        }

        .custom-sidebar a:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--accent-color);
        }

        .custom-sidebar a.active {
            background: var(--accent-color);
            color: var(--text-dark);
        }

        .logout-btn {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: var(--text-light);
            padding: 0.5rem 1rem;
            border-radius: 6px;
            width: 100%;
            margin-top: 1rem;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--accent-color);
        }

        /* Main content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            min-height: 100vh;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 2rem;
            color: var(--accent-color);
        }

        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .table {
            color: var(--text-light);
        }

        .table th {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
            color: var(--accent-color);
        }

        .table td {
            border-color: rgba(255, 255, 255, 0.1);
        }

        .form-label {
            color: var(--text-light);
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-light);
            border-radius: 8px;
            padding: 0.75rem;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.25rem rgba(255, 215, 0, 0.25);
            color: var(--text-light);
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .btn-primary {
            background: var(--accent-color);
            border: none;
            color: var(--text-dark);
            font-weight: 500;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: #e6c200;
            transform: translateY(-2px);
        }

        .observer-assignment {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 1rem;
            margin-top: 1rem;
        }

        .alert {
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.2);
            border: 1px solid rgba(40, 167, 69, 0.4);
            color: #d4edda;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.4);
            color: #f8d7da;
        }

        .schedule-checkbox {
            margin-right: 0.5rem;
        }

        .table-responsive {
            max-height: 500px;
            overflow-y: auto;
        }

        @media (max-width: 768px) {
            .custom-sidebar {
                transform: translateX(-100%);
            }
            .main-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="custom-sidebar">
                <h6>Welcome, <%= firstName %> <%= lastName %></h6>
                <small><%= employeeId %></small>
                <hr>
                <a href="/Observer_dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a href="/observer_copus"><i class="bi bi-book"></i> Copus</a>
                <a href="/Observer_copus_result"><i class="bi bi-clipboard-data"></i> Copus Result</a>
                <a href="/Observer_copus_history"><i class="bi bi-calendar-event-fill"></i> Copus History</a>
                <a href="/Observer_schedule_management"><i class="bi bi-clipboard-data"></i> Schedule</a>
                <a href="/alc_create_observation_schedule" class="active"><i class="bi bi-calendar-plus"></i> Create Observation Schedule</a>
                <a href="/Observer_setting"><i class="bi bi-gear-fill"></i> Settings</a>
                <hr>
                <form action="/logout" method="POST">
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
            </div>

            <!-- Main Content -->
            <div class="main-content">
                <h1 class="page-title">Create Observation Schedules</h1>
                
                <!-- Flash Messages -->
                <% if (success_msg && success_msg.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (error_msg && error_msg.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card">
                    <h5 class="mb-3">Available Admin Template Schedules</h5>
                    <form method="POST" action="/alc_create_observation_slots" id="observationForm">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox" id="selectAll" class="form-check-input">
                                            Select
                                        </th>
                                        <th>Faculty</th>
                                        <th>Department</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Details</th>
                                        <th>Observer Assignment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (adminTemplates && adminTemplates.length > 0) { %>
                                        <% adminTemplates.forEach(template => { %>
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="selectedTemplates" 
                                                           value="<%= template._id %>" 
                                                           class="form-check-input schedule-checkbox">
                                                </td>
                                                <td>
                                                    <%= template.faculty_user_id ? 
                                                        `${template.faculty_user_id.firstname} ${template.faculty_user_id.lastname}` : 
                                                        'N/A' %>
                                                </td>
                                                <td><%= template.faculty_user_id?.department || 'N/A' %></td>
                                                <td><%= new Date(template.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></td>
                                                <td><%= template.start_time %> - <%= template.end_time %></td>
                                                <td>
                                                    <small>
                                                        Year: <%= template.year_level %><br>
                                                        Semester: <%= template.semester %><br>
                                                        Modality: <%= template.modality %>
                                                    </small>
                                                </td>
                                                <td>
                                                    <select name="observerAssignments[<%= template._id %>]" 
                                                            class="form-select form-select-sm" multiple>
                                                        <% if (observers && observers.length > 0) { %>
                                                            <% observers.forEach(observer => { %>
                                                                <option value="<%= observer._id %>">
                                                                    <%= observer.firstname %> <%= observer.lastname %> 
                                                                    (<%= observer.role %>)
                                                                </option>
                                                            <% }); %>
                                                        <% } %>
                                                    </select>
                                                    <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">
                                                No admin template schedules available for conversion.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <% if (adminTemplates && adminTemplates.length > 0) { %>
                            <div class="observer-assignment">
                                <h6 class="mb-3">Observation Details</h6>
                                <div class="row">
                                    <div class="col-md-3 mb-3">
                                        <label for="copusType" class="form-label">COPUS Type</label>
                                        <select class="form-select" id="copusType" name="copusType" required>
                                            <option value="">Select COPUS Type</option>
                                            <option value="Copus 1">COPUS 1</option>
                                            <option value="Copus 2">COPUS 2</option>
                                            <option value="Copus 3">COPUS 3</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label for="subjectCode" class="form-label">Subject Code</label>
                                        <input type="text" class="form-control" id="subjectCode" name="subjectCode" 
                                               placeholder="e.g., CS101" required>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label for="subjectName" class="form-label">Subject Name</label>
                                        <input type="text" class="form-control" id="subjectName" name="subjectName" 
                                               placeholder="e.g., Introduction to Computer Science" required>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label for="room" class="form-label">Room</label>
                                        <input type="text" class="form-control" id="room" name="room" 
                                               placeholder="e.g., Room 101" required>
                                    </div>
                                </div>
                            </div>

                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Create Observation Slots
                                </button>
                            </div>
                        <% } %>
                    </form>
                </div>

                <div class="card">
                    <h5 class="mb-3">Instructions</h5>
                    <ul>
                        <li>Select admin template schedules to convert into observation slots.</li>
                        <li>Assign observers to each schedule (multiple observers can be assigned).</li>
                        <li>Fill in the observation details that will apply to all selected schedules.</li>
                        <li>Once created, faculty members can select from these observation slots.</li>
                        <li>Selected templates will be marked as "scheduled" and won't appear here again.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Select all functionality
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('input[name="selectedTemplates"]');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Update select all checkbox when individual checkboxes change
        document.querySelectorAll('input[name="selectedTemplates"]').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const allCheckboxes = document.querySelectorAll('input[name="selectedTemplates"]');
                const checkedCheckboxes = document.querySelectorAll('input[name="selectedTemplates"]:checked');
                const selectAllCheckbox = document.getElementById('selectAll');
                
                selectAllCheckbox.checked = allCheckboxes.length === checkedCheckboxes.length;
                selectAllCheckbox.indeterminate = checkedCheckboxes.length > 0 && checkedCheckboxes.length < allCheckboxes.length;
            });
        });

        // Form validation
        document.getElementById('observationForm').addEventListener('submit', function(e) {
            const selectedTemplates = document.querySelectorAll('input[name="selectedTemplates"]:checked');
            if (selectedTemplates.length === 0) {
                e.preventDefault();
                alert('Please select at least one template schedule.');
                return false;
            }

            // Check if observers are assigned to selected templates
            let hasUnassignedObservers = false;
            selectedTemplates.forEach(checkbox => {
                const templateId = checkbox.value;
                const observerSelect = document.querySelector(`select[name="observerAssignments[${templateId}]"]`);
                if (!observerSelect || observerSelect.selectedOptions.length === 0) {
                    hasUnassignedObservers = true;
                }
            });

            if (hasUnassignedObservers) {
                if (!confirm('Some selected schedules have no observers assigned. Continue anyway?')) {
                    e.preventDefault();
                    return false;
                }
            }
        });
    </script>
</body>
</html>